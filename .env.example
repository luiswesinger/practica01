# ---------------------------------------------------------------------------
# Variables de entorno de SmartCampus · PLANTILLA
#
# Cómo usarla:
#   cp .env.example .env
#
# Docker Compose lee automáticamente el fichero '.env' si existe. Si no
# existe, 'docker-compose.yml' aplica estos mismos valores por defecto, así
# que el proyecto funciona igualmente sin crear nada.
#
# ⚠️  El fichero '.env' está excluido por .gitignore: nunca se sube al
#     repositorio. Estas credenciales son deliberadamente simples porque el
#     entorno es local y de prácticas. No son secretos reales.
# ---------------------------------------------------------------------------

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=smartcampus
POSTGRES_USER=smartcampus
POSTGRES_PASSWORD=smartcampus_dev

# --- Puertos publicados en el equipo anfitrión ------------------------------
#
# IMPORTANTE: cambiad solo el LADO IZQUIERDO del mapeo. El puerto de la derecha
# es el que usa el proceso DENTRO del contenedor (8888 Jupyter, 5000 Flask) y
# no debe cambiarse.
#
# PostgreSQL (5432) no se publica al host a propósito: solo lo consumen los
# servicios 'api' y 'jupyter' a través de la red interna de Compose. Así el
# puerto del anfitrión no puede entrar en conflicto.
#
# --- Conflictos conocidos en macOS -----------------------------------------
#
#   Puerto 5000  →  Lo ocupa el sistema: "Receptor de AirPlay"
#                   (Centro de Control). Se desactiva en
#                   Ajustes del Sistema → General → AirPlay y Handoff,
#                   o simplemente se usa API_PORT=5001.
#
#   Puerto 8888  →  Puede estar ocupado si tenéis otro Jupyter en marcha
#                   (por ejemplo, otro taller de la asignatura).
#
#   Puerto 8889  →  Puerto alternativo recomendado para Jupyter.
#
# La configuración que se usó para verificar este proyecto, con los conflictos
# anteriores ya resueltos, fue:
#
#   JUPYTER_PORT=8889
#   API_PORT=5001
#
JUPYTER_PORT=8888
API_PORT=5000
